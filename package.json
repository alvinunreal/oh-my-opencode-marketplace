{
  "name": "oh-my-opencode-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "validate": "bun run src/cli.ts validate",
    "build": "bun run src/cli.ts build",
    "verify-additive": "bun run src/cli.ts verify-additive",
    "verify-generated": "bun run src/cli.ts verify-generated",
    "verify-main": "bun run src/cli.ts verify-main",
    "validate-deploy": "wrangler deploy --dry-run",
    "deploy": "bun run src/cli.ts deploy && wrangler deploy",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oh-my-opencode-slim": "3.0.0-beta.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "wrangler": "4.131.1"
  }
}
